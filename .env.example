# Copy to .env and fill in. Never commit .env.

# Buffer (social publishing): API key + one channel ID per platform
# (list IDs with: node --strip-types --env-file=.env scripts/get-buffer-channels.ts)
BUFFER_API_KEY=
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_YOUTUBE_CHANNEL_ID=
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_FACEBOOK_POST_TYPE=reel
# BUFFER_SHARE_MODE=shareNow   # or addToQueue

# Cloudinary (hosts the MP4 that Buffer pulls)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: path to ffmpeg for voiceover post-processing
# (defaults to the ffmpeg bundled in node_modules/@remotion/compositor-win32-x64-msvc)
# FFMPEG_PATH=

# Optional: Remotion Lambda cloud rendering (scripts/cloud-render.sh)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Optional alternative TTS engines (default engine is local ZeroTTS, no key needed)
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_VOICE=en-US-EmmaMultilingualNeural
AZURE_SPEECH_RATE=+40%
AZURE_SPEECH_VOLUME=+60%
AZURE_ENGLISH_TERMS=Remotion|Buffer|Cloudinary
EDGE_SPEECH_VOICE=en-US-EmmaMultilingualNeural
EDGE_SPEECH_RATE=+40%
EDGE_SPEECH_VOLUME=+60%
EDGE_SEGMENT_CROSSFADE_MS=35
